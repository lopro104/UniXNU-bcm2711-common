# BCM2711: four Cortex-A72 (ARMv8.0-A) cores and a GIC-400.
# ARMv8.0 has no PAN (ARMv8.1), so the native PAN support stays off.
CONFIG_XNU_NATIVE_PAN=n
# GICv2 path of ArmCpu (scripts/build-arm-driver.py passes -DARMCPU_GICV2=1).
CONFIG_XNU_ARMCPU_GICV2=y
# Keep the native architectural timer entry. At 0, architectural-timer-entry.patch compiles the BCM2837 local
# interrupt router write (0x40000040 + cpu * 4) into start.s; on the BCM2711 the ARM local block moved to 0xff800000
# and 0x40000040 is DRAM.
CONFIG_XNU_NATIVE_ARCH_TIMER=y
